# Copy to your shell profile or project .env (never commit secrets).

# Master switch — default OFF (unset / false / 0 / off / no)
CLAUDE_JEV_GATE_ENABLED=false

# Confidence floor for allow-once (default 0.80; effective floor >= 0.5)
# CLAUDE_JEV_GATE_MIN_CONFIDENCE=0.80

# Jev call timeout seconds (default 8)
# CLAUDE_JEV_GATE_TIMEOUT_SECONDS=8

# Live TypeSafe (never commit the key). Forbidden: Vercel AI Gateway.
# TYPESAFE_API_KEY=
# CLAUDE_JEV_GATE_JEV_MODEL=jev-latest

# Optional typesafe_sdk path injection (same idea as hermes-jev-router)
# CLAUDE_JEV_GATE_TYPESAFE_VENV=/workspace/tools/typesafe-venv
# CLAUDE_JEV_GATE_TYPESAFE_SITE_PACKAGES=

# Mock for local prove (approve|deny|unsure|low_confidence|timeout|error|malformed)
# CLAUDE_JEV_GATE_MOCK=approve

# Events log path (default: ~/.claude/claude-jev-gate/events.jsonl)
# CLAUDE_JEV_GATE_EVENTS_PATH=
