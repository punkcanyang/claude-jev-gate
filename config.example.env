# Copy into your shell profile or project .env (never commit secrets).

# ========== 三开关（默认全关）==========
CLAUDE_JEV_GATE_ENABLED=false
CLAUDE_JEV_ROUTE_ENABLED=false
CLAUDE_JEV_TRIM_COMPRESS_ENABLED=false

# ========== 工具闸（PermissionRequest）==========
# CLAUDE_JEV_GATE_MIN_CONFIDENCE=0.80
# CLAUDE_JEV_GATE_TIMEOUT_SECONDS=8
# CLAUDE_JEV_GATE_MOCK=approve
# CLAUDE_JEV_GATE_JEV_MODEL=jev-latest
# CLAUDE_JEV_GATE_EVENTS_PATH=

# hooks／代理解释器：默认 typesafe-venv（勿裸 python3）
# CLAUDE_JEV_GATE_PYTHON=/workspace/tools/typesafe-venv/bin/python
# CLAUDE_JEV_GATE_TYPESAFE_VENV=/workspace/tools/typesafe-venv
# CLAUDE_JEV_GATE_TYPESAFE_SITE_PACKAGES=

# Live TypeSafe（禁止 Vercel AI Gateway）
# TYPESAFE_API_KEY=

# ========== 路由（代理内）==========
# CLAUDE_JEV_PRIMARY_MODEL=deepseek-chat
# CLAUDE_JEV_MODEL_CHEAP=deepseek-chat
# CLAUDE_JEV_MODEL_COMPLEX=deepseek-reasoner
# CLAUDE_JEV_MODEL_TOOL_HEAVY=deepseek-reasoner
# CLAUDE_JEV_MODEL_LONG_CONTEXT=deepseek-reasoner
# CLAUDE_JEV_ROUTE_MIN_CONFIDENCE=0.55
# CLAUDE_JEV_ROUTE_TIMEOUT_SECONDS=8
# CLAUDE_JEV_ROUTE_MOCK=heuristic
# CLAUDE_JEV_ROUTE_JEV_MODEL=jev-latest

# ========== 裁压（代理内；强制 trim→compress）==========
# CLAUDE_JEV_TRIM_KEEP_LAST_N=6
# CLAUDE_JEV_TRIM_DROP_OLD_TOOL_NOISE=true

# ========== 代理 ==========
# CLAUDE_JEV_PROXY_HOST=127.0.0.1
# CLAUDE_JEV_PROXY_PORT=8787
# Claude Code → export ANTHROPIC_BASE_URL=http://127.0.0.1:8787
# CLAUDE_JEV_UPSTREAM_BASE_URL=https://api.deepseek.com/anthropic
# CLAUDE_JEV_UPSTREAM_API_KEY=
# 或 ANTHROPIC_API_KEY= / DEEPSEEK_API_KEY=
# 无 Key 本地证明：
# CLAUDE_JEV_UPSTREAM_MOCK=1
